# TrustDesk environment — copy to `.env` and fill in secrets.
#   cp .env.example .env
# `.env` is gitignored; only this example is committed.

# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---- Database ----
# Local Docker Mongo (see docker-compose.yml). In Docker Compose the server
# reaches Mongo at mongodb://mongo:27017/trustdesk instead.
MONGODB_URI=mongodb://localhost:27017/trustdesk

# ---- Auth (required from Phase 1.5) ----
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=replace-with-64-hex-chars
AUTH_TOKEN_TTL=8h
# Seeded demo user passwords (hashed with bcrypt at seed time; never logged).
DEMO_AGENT_PASSWORD=replace-me
DEMO_MANAGER_PASSWORD=replace-me

# ---- LLM provider (uniform across Anthropic / OpenAI / Google / Groq) ----
# Pick a provider + key; the base URL and SDK are derived from the provider.
# `mock` needs no key and is the default for local dev, tests and CI.
#   LLM_PROVIDER=groq       LLM_MODEL=llama-3.3-70b-versatile
#   LLM_PROVIDER=openai     LLM_MODEL=gpt-4o-mini
#   LLM_PROVIDER=google     LLM_MODEL=gemini-2.0-flash
#   LLM_PROVIDER=anthropic  LLM_MODEL=claude-opus-5-5
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
# Optional: override the per-provider base URL (proxy / self-hosted gateway only).
LLM_BASE_URL=
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2

# ---- Prompt / eval settings (used from Phase 3) ----
# Random 16-char tripwire the output guard scans for in model output.
PROMPT_CANARY=replace-with-random-16
PROMPT_VERSION=v1
EVAL_CONCURRENCY=2
MOCK_DELAY_MS=0

# ---- CORS / data ----
CORS_ORIGIN=http://localhost:5173
# Seed source, read by the seeder (Phase 1.4), relative to the server process.
DATA_DIR=../data

# ---- Client (Vite) ----
# The only variable the browser receives; holds no secret.
VITE_API_BASE_URL=http://localhost:4000/api
