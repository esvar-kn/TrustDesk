# ---- Dependencies ----
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# ---- Environment & secrets ----
# Commit .env.example only; never the real secrets.
.env
.env.*
!.env.example
*.pem
*.key

# ---- Build output ----
dist/
build/
client/dist/
server/dist/
.vite/
*.tsbuildinfo

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Test & coverage ----
coverage/
.nyc_output/
*.lcov

# ---- Eval & generated reports ----
# Keep the committed report (docs/EVAL_REPORT.md); ignore raw run dumps.
docs/eval/
server/scripts/out/

# ---- Databases & local data ----
*.sqlite
*.sqlite3
*.db
mongo-data/
data/holdout/*.local.*

# ---- Caches ----
.cache/
.eslintcache
.parcel-cache/

# ---- Python (scripts/) ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ---- Editors & tooling ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS ----
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
